# Copy to .env and export the variables before running the Python server.
ANTHROPIC_API_KEY=
OPTO_AI_TOKEN=
OPTO_AI_OWNER_TOKEN=
OPTO_AI_PORT=8070
OPTO_AI_DIR=.local/opto-ai
OPTO_AI_BANK=.local/bank.json
OPTO_AI_NIGHTLY=0

# Set these in the app's local Xcode Run scheme when using a self-hosted service.
# Use OPTO_AI_TOKEN from above. Keep the provider key on the server.
OPTO_AI_BASE_URL=
OPTO_AI_FALLBACK_URLS=
